# Copy to .env and edit. The shell wins over .env, e.g. GLADIUS_WORKSPACE=~/notes ./run.sh

# Folder of your own .md / .txt notes to search. Absolute, ~/..., or relative to the repo.
# Top-level subfolders become collections; see rag/workspace.py. Default: the sample student.
GLADIUS_WORKSPACE=data/student

# What each chunk is embedded with (rag/context.py): "llm" = file and heading path plus a sentence
# the model writes about where the chunk sits (python -m rag.context writes them; run.sh does it for
# you), "path" = file and heading path only, "off" = heading only, as before. Default: llm.
# GLADIUS_RAG_CONTEXT=llm

# Pin "today" (YYYY-MM-DD) for demos and benchmarks; unset means the real date.
# GLADIUS_TODAY=2025-10-06

# llama-server address.
# LLAMA_URL=http://127.0.0.1:8080
